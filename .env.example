# Supabase Session Pooler connection string.
# Get this from: Supabase dashboard -> Project Settings -> Database ->
# Connection String -> "Session pooler" tab.
#
# Format:
# postgresql+psycopg2://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Never commit the real .env file -- only this template.
DATABASE_URL=postgresql+psycopg2://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:5432/postgres
